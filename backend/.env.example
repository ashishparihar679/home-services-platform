# Local Django and MySQL settings. Replace placeholders only in backend/.env.
DB_NAME=home_services_db
DB_USER=home_services_app
DB_PASSWORD=replace-with-a-strong-unique-password
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional locally; set to the uploaded Aiven CA file path in production.
DB_SSL_CA=
SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=3600
